{
    "name": "class-atlas/laravel-usms",
    "description": "Laravel client for the uBill SMS API: sends, personalized batches, delivery reports, incoming SMS, brand names and callbacks.",
    "keywords": [
        "laravel",
        "sms",
        "ubill",
        "usms",
        "notification",
        "georgia",
        "saloon"
    ],
    "homepage": "https://github.com/ClassAtlas/laravel-usms",
    "license": "MIT",
    "authors": [
        {
            "name": "Irakli Kirkitadze",
            "email": "kirkita205@gmail.com",
            "role": "Author"
        },
        {
            "name": "Alexander Kupatadze",
            "email": "h3xlay@gmail.com",
            "role": "Contributor"
        }
    ],
    "support": {
        "issues": "https://github.com/ClassAtlas/laravel-usms/issues",
        "source": "https://github.com/ClassAtlas/laravel-usms",
        "security": "https://github.com/ClassAtlas/laravel-usms/security/policy"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0||^13.0",
        "saloonphp/saloon": "^4.5",
        "spatie/laravel-data": "^4.20",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.7||^5.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "ClassAtlas\\USms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClassAtlas\\USms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ClassAtlas\\USms\\USmsServiceProvider"
            ],
            "aliases": {
                "USms": "ClassAtlas\\USms\\Facades\\USms"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
