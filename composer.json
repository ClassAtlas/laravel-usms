{
    "name": "class-atlas/laravel-usms",
    "description": "Laravel package for seamless SMS sending via Ubill API",
    "keywords": [
        "laravel",
        "sms",
        "ubill",
        "notification",
        "usms"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Irakli Kirkitadze",
            "email": "kirkita205@gmail.com",
            "role": "Author"
        },
        {
            "name": "Alexander Kupatadze",
            "email": "h3xlay@gmail.com",
            "role": "Contributor"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-readline": "*",
        "illuminate/contracts": "^12.0||^13.0",
        "saloonphp/saloon": "^4.5",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "ClassAtlas\\USms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClassAtlas\\USms\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ClassAtlas\\USms\\USmsServiceProvider"
            ],
            "aliases": {
                "USms": "ClassAtlas\\USms\\Facades\\USms"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
